# Copy to .env.local and fill in. Only DATABASE_URL, AUTH_SECRET and AUTH_URL
# are required to run locally; everything else degrades gracefully.

# --- Database (Postgres) ---
DATABASE_URL=postgresql://lipemoves:lipemoves@localhost:5432/lipemoves
# Neon only: direct (non-pooled) connection used by drizzle-kit
DATABASE_URL_UNPOOLED=

# --- Auth (NextAuth v5) ---
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=http://localhost:3000
BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_ANNUAL_PRICE_ID=

# --- Bunny.net Stream (video hosting) ---
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_KEY=
BUNNY_WEBHOOK_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Studio / content tooling (optional) ---
GEMINI_API_KEY=
SAY_VOICE=
SAY_RATE=
